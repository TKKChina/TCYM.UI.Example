<Project Sdk="Microsoft.NET.Sdk">

  <!-- AotAnywhere: 使用内置 Zig 工具链，从 Windows/macOS/Linux 交叉发布 Native AOT 到多平台 RID。 -->
  <Sdk Name="StuDev.AotAnywhere" Version="1.0.4" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TCYMSourcePreviewComponentRoot>Page/component</TCYMSourcePreviewComponentRoot>
    <TCYMSourcePreviewDefaultEntry>Page/Layout/AppShell.cs</TCYMSourcePreviewDefaultEntry>
    <TCYMSourcePreviewGlobalCss>Page/com.css</TCYMSourcePreviewGlobalCss>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);IL2072;IL2075;IL2104;IL3053</NoWarn>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <!-- Windows EXE 图标（写入可执行文件资源） -->
    <ApplicationIcon>Assets\Images\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Page\component\UILabel\**" />
    <EmbeddedResource Remove="Page\component\UILabel\**" />
    <None Remove="Page\component\UILabel\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Fonts\iconfont.ttf" />
